<?xml version="1.0" encoding="UTF-8"?>
<!--
  FuelMind MSI.

  Build it with installer\build.ps1, which compiles the binaries into
  dist\ first and passes the version in:

      powershell -File installer\build.ps1 -Version 1.1.0

  Layout it produces:
    %ProgramFiles%\FuelMind\      fuelmind-launcher.exe (the service),
                                  FuelMindCore.exe (adopted on first run),
                                  fuelmind-setup.exe (support tool)
    %ProgramData%\FuelMind\       database, logs, versions, POS drop folder
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension"
     xmlns:fire="http://schemas.microsoft.com/wix/FirewallExtension">
  <?define UpgradeGuid = "8F6B2C4A-1D3E-4F7A-9B5C-2E8A6D0F1B3C" ?>

  <Product Id="*" Name="FuelMind" Language="1033" Version="$(var.Version)"
           Manufacturer="FuelMind" UpgradeCode="$(var.UpgradeGuid)">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="FuelMind local core for fuel stations" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of FuelMind is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="FuelMind" />
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="FUELMIND_DATA" Name="FuelMind">
          <Directory Id="FUELMIND_POSDROP" Name="pos_drop" />
        </Directory>
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <!-- The core binary. The launcher copies it into
           %ProgramData%\FuelMind\versions\<version>\ on first start. -->
      <Component Id="CoreExe" Guid="*">
        <File Id="FuelMindCore.exe" Name="FuelMindCore.exe"
              Source="$(var.DistDir)\FuelMindCore.exe" KeyPath="yes" />
      </Component>

      <Component Id="SetupExe" Guid="*">
        <File Id="fuelmind_setup.exe" Name="fuelmind-setup.exe"
              Source="$(var.DistDir)\fuelmind-setup.exe" KeyPath="yes" />
      </Component>

      <!-- The Windows service. It runs as LocalService (least privilege)
           and restarts itself if it ever fails. -->
      <Component Id="ServiceExe" Guid="*">
        <File Id="fuelmind_launcher.exe" Name="fuelmind-launcher.exe"
              Source="$(var.DistDir)\fuelmind-launcher.exe" KeyPath="yes" />
        <ServiceInstall Id="FuelMindServiceInstall"
                        Name="FuelMindService"
                        DisplayName="FuelMind"
                        Description="Reads POS exports, keeps the FuelMind database and serves the local dashboard."
                        Type="ownProcess"
                        Start="auto"
                        Account="NT AUTHORITY\LocalService"
                        ErrorControl="normal"
                        Vital="yes"
                        Interactive="no">
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="FuelMindServiceControl" Name="FuelMindService"
                        Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <!-- Let phones and PCs on the station LAN reach the dashboard. -->
        <fire:FirewallException Id="DashboardPort" Name="FuelMind dashboard"
                                Port="8765" Protocol="tcp" Scope="localSubnet"
                                Description="FuelMind dashboard on the station network" />
      </Component>
    </DirectoryRef>

    <!-- Data directory: readable and writable by the service account and
         administrators only. It survives uninstall (it holds the owner's
         sales history); the uninstaller leaves it in place. -->
    <DirectoryRef Id="FUELMIND_DATA">
      <Component Id="DataFolder" Guid="*">
        <CreateFolder>
          <util:PermissionEx User="LocalService" Domain="NT AUTHORITY" GenericAll="yes" />
          <util:PermissionEx User="Administrators" GenericAll="yes" />
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM" Key="Software\FuelMind" Name="DataDir"
                       Type="string" Value="[FUELMIND_DATA]" KeyPath="yes" />
      </Component>
    </DirectoryRef>



    <DirectoryRef Id="FUELMIND_POSDROP">
      <Component Id="PosDropFolder" Guid="*">
        <CreateFolder />
        <RegistryValue Root="HKLM" Key="Software\FuelMind" Name="PosDrop"
                       Type="string" Value="[FUELMIND_POSDROP]" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- After install, open the dashboard so the owner can set the PIN.
         The first PIN can only be set from this PC (loopback). -->
    <Property Id="WixShellExecTarget" Value="http://localhost:8765/" />
    <CustomAction Id="OpenDashboard" BinaryKey="WixCA" DllEntry="WixShellExec"
                  Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="OpenDashboard" After="InstallFinalize">NOT Installed AND NOT REMOVE</Custom>
    </InstallExecuteSequence>

    <Feature Id="ProductFeature" Title="FuelMind" Level="1">
      <ComponentRef Id="CoreExe" />
      <ComponentRef Id="ServiceExe" />
      <ComponentRef Id="SetupExe" />
      <ComponentRef Id="DataFolder" />
      <ComponentRef Id="PosDropFolder" />
    </Feature>
  </Product>
</Wix>
